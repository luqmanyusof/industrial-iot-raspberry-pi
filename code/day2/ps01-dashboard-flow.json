    "func": "const gw = flow.get('gateway');\nif (!gw) {\n    node.warn('No telemetry yet, so the gateway name is unknown');\n    return null;\n}\nmsg.topic = `ps01/${gw}/pump/cmd`;\nreturn msg;",
