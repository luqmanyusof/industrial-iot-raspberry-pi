  {
    "id": "fn-pump",
    "type": "function",
    "name": "pump state",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 440,
    "func": "const s = msg.payload;\n// Pop up a warning only when a START was refused by the interlock\nconst refused = (s.reason || '').includes('refused') ? { payload: s.reason } : null;\nreturn [\n    { payload: `${s.pump} \u00b7 door ${s.door || '?'}` },\n    { payload: s.reason },\n    refused,\n];",
    "wires": [
      [
        "txt-pump"
