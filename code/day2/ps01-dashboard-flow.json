  {
    "id": "fn-split",
    "type": "function",
    "name": "split the reading",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 80,
    "func": "// Remember which gateway this broker belongs to (used by the pump buttons)\nflow.set('gateway', msg.topic.split('/')[1]);\n\nconst r = msg.payload;\nconst one = (v, unit) => (v === null || v === undefined) ? '\u2014' : v.toFixed(1) + unit;\nlet plant = r.status;\nif (r.e_stop) plant += ' \u00b7 E-STOP ACTIVE';\n\nreturn [\n    r.tank_level_pct === null ? null : { payload: r.tank_level_pct },              // gauge\n    r.tank_level_pct === null ? null : { topic: 'tank level', payload: r.tank_level_pct },  // chart\n    { payload: one(r.room_temp_c, ' \u00b0C') },\n    { payload: one(r.room_humidity_pct, ' %') },\n    { payload: plant },\n];",
    "wires": [
      [
        "gauge-level"
      ],
      [
        "chart-level"
      ],
      [
        "txt-temp"
      ],
      [
        "txt-hum"
      ],
      [
        "txt-plant"
      ]
    ],
    "z": "ps01-tab"
  },
